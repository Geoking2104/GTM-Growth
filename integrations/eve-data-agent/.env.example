# Copy to .env.local. One independent installation and secret per tenant binding.
AI_GATEWAY_API_KEY=
GTM_AGENT_MODEL=anthropic/claude-sonnet-5
SLACK_CONNECTOR=slack/gtm-growth
SLACK_TEAM_ID=
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
# Exact public HTTPS URL; no redirects followed. Not the generic MCP endpoint.
GTM_AGENT_BRIDGE_URL=https://gtm.kayroslab.com/api/internal/data-agent/read
# Same random >=32-character secret as the server binding's secretEnv value.
GTM_AGENT_BRIDGE_SECRET=
