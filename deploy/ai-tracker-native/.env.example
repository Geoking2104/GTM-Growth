# Native AI tracker — copy to .env and fill in. Never commit real values.

# Global kill-switch. false by default; enabling is an explicit admin decision.
AI_TRACKER_ENABLED=false

# Per-engine scraper flags. All false by default (API-first).
AI_TRACKER_SCRAPER_CHATGPT_ENABLED=false
AI_TRACKER_SCRAPER_GEMINI_ENABLED=false
AI_TRACKER_SCRAPER_GOOGLE_AI_MODE_ENABLED=false
AI_TRACKER_SCRAPER_PERPLEXITY_ENABLED=false
AI_TRACKER_SCRAPER_BING_AI_MODE_ENABLED=false

# Official API keys (optional; each engine runs API-first when its key is set).
AI_TRACKER_OPENAI_KEY=
AI_TRACKER_ANTHROPIC_KEY=
AI_TRACKER_GEMINI_KEY=
AI_TRACKER_MISTRAL_KEY=
AI_TRACKER_PERPLEXITY_KEY=

# Local judge
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b

# Scheduling and storage
AI_TRACKER_RUN_HOUR=07:00
AI_TRACKER_LOCALE_DEFAULT=fr-FR
AI_TRACKER_TENANT_ID=
AI_TRACKER_DB_PATH=data/ai-tracker.sqlite3
AI_TRACKER_SCRAPER_SESSION_DIR=data/ai-tracker-sessions
# Path to the Chromium binary inside the worker image.
AI_TRACKER_CHROMIUM_PATH=
