# This file remains on the VPS as deploy/kayroslab-vps/.env.local (chmod 600).
# Do not commit real values.
MCP_API_TOKEN=replace-with-a-long-random-token
SITE_ORIGINS=https://gtm.kayroslab.com

# deploy.sh generates the database password, signing secret and metrics token once.
# PostgreSQL and queue Redis are private, dedicated services in this Compose stack.
AUDIT_JOBS_ENABLED=true
# AUDIT_DB_PASSWORD=                # generated, hexadecimal; never commit
# AUDIT_JOBS_SECRET=                # generated; keep with the database backup
# METRICS_TOKEN=                    # generated; protects /api/metrics

# Optional: send a new report request to a private webhook.
# LEAD_WEBHOOK_URL=

# Optional free-report access by email code (inactive until SMTP is configured).
# deploy.sh generates a dedicated 64-character REPORT_ACCESS_SECRET on first run.
REPORT_ACCESS_ENABLED=false
REPORT_PUBLIC_ORIGIN=https://gtm.kayroslab.com
# REPORT_SMTP_HOST=smtp.your-provider.example
# REPORT_SMTP_PORT=587                # STARTTLS (465 uses implicit TLS)
# REPORT_SMTP_USER=account@example.com
# REPORT_SMTP_PASSWORD=              # secret; never commit
# REPORT_SMTP_FROM=reports@example.com

# Optional Google product configuration. The service-account JSON itself lives
# outside Git at /opt/gtm-growth/.secrets/service-account.json.
# GA4_PROPERTY_ID=
# GOOGLE_API_KEY=
# PAGESPEED_API_KEY=
# CRUX_API_KEY=

# ── Keycloak (SSO de la console) ── à générer sur le VPS, jamais versionné :
#   openssl rand -base64 32
KC_DB_PASSWORD=replace-with-a-random-db-password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
KC_HOSTNAME=https://auth.kayroslab.com
OIDC_ISSUER=https://auth.kayroslab.com/realms/gtm-growth
# Optionnel : valeurs pré-remplies dans la console
# CONSOLE_DEFAULT_URL=https://kayroslab.com
# CONSOLE_DEFAULT_PROPERTY=sc-domain:kayroslab.com
# Optionnel (phase 3) : générateur de contenu via Ollama auto-hébergé
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=mistral

# --- Multi-tenant (clients GTM Growth) ---
# Service account du client gtm-provisioner (secret généré dans la console Keycloak, jamais commité).
KEYCLOAK_ADMIN_REALM=gtm-growth
KEYCLOAK_ADMIN_CLIENT_ID=gtm-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Émetteurs supplémentaires (realms dédiés hors registre), séparés par des virgules.
OIDC_EXTRA_ISSUERS=
# Optional read-only Eve bridge. Bindings file belongs in the existing /secrets mount.
# GTM_DATA_AGENT_BINDINGS_FILE=/secrets/data-agent-bindings.json
# GTM_AGENT_SECRET_CUSTOMER=<distinct-random-secret-at-least-32-characters>

# Cloud billing. Disabled by default; never reuse openDPE credentials.
BILLING_MODE=disabled
BILLING_CHECKOUT_ENABLED=false
BILLING_PUBLIC_ORIGIN=https://gtm.kayroslab.com
MOLLIE_GTM_API_KEY=
MOLLIE_GTM_PROFILE_ID=
MOLLIE_GTM_WEBHOOK_URL=https://gtm.kayroslab.com/api/billing/mollie/webhook
MOLLIE_GTM_RETURN_URL=https://gtm.kayroslab.com/console/?checkout=return#billing
BILLING_DATA_PATH=/data/billing.sqlite3
BILLING_CLOUD_TENANTS=
# Required before enrollment. Set owner-approved values; examples are test fixtures only:
# BILLING_LIMITS_JSON={"version":"test-v1","solo":{"monthlyOperations":10,"maxDomains":1},"agency":{"monthlyOperations":100,"maxDomains":5}}
BILLING_LIMITS_JSON=
BILLING_TERMS_VERSION=
BILLING_TERMS_URL_EN=
BILLING_TERMS_URL_FR=
BILLING_PRICES_APPROVED=false
BILLING_LIVE_APPROVED=false
BILLING_PRICE_INCLUDES_TAX=
BILLING_SOLO_AMOUNT_CENTS=
BILLING_AGENCY_AMOUNT_CENTS=
BILLING_GRACE_DAYS=7
BILLING_RECONCILE_ENABLED=false
BILLING_RECONCILE_TOKEN=

# Decision inbox, intent associations, measurement audits and portfolio snapshots.
# Default: decision.sqlite3 beside TENANTS_PATH, on the persistent data volume.
# DECISION_PATH=/app/data/decision.sqlite3

# MCP OAuth (Keycloak). The workspace static token stays available until disabled.
MCP_RESOURCE=https://gtm.kayroslab.com/mcp
MCP_PUBLIC_ORIGIN=https://gtm.kayroslab.com
# true (default when MCP_API_TOKEN is set) keeps the operator token for existing connectors.
MCP_STATIC_TOKEN_ENABLED=true
