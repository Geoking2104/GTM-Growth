# This file remains on the VPS as deploy/kayroslab-vps/.env.local (chmod 600).
# Do not commit real values.
MCP_API_TOKEN=replace-with-a-long-random-token
SITE_ORIGINS=https://gtm.kayroslab.com

# Optional: send a new report request to a private webhook.
# LEAD_WEBHOOK_URL=

# Optional Google product configuration. The service-account JSON itself lives
# outside Git at /opt/gtm-growth/.secrets/service-account.json.
# GA4_PROPERTY_ID=
# GOOGLE_API_KEY=
# PAGESPEED_API_KEY=
# CRUX_API_KEY=

# ── Keycloak (SSO de la console) ── à générer sur le VPS, jamais versionné :
#   openssl rand -base64 32
KC_DB_PASSWORD=replace-with-a-random-db-password
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
KC_HOSTNAME=https://auth.kayroslab.com
OIDC_ISSUER=https://auth.kayroslab.com/realms/gtm-growth
# Optionnel : valeurs pré-remplies dans la console
# CONSOLE_DEFAULT_URL=https://kayroslab.com
# CONSOLE_DEFAULT_PROPERTY=sc-domain:kayroslab.com
# Optionnel (phase 3) : générateur de contenu via Ollama auto-hébergé
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=mistral

# --- Multi-tenant (clients GTM Growth) ---
# Service account du client gtm-provisioner (secret généré dans la console Keycloak, jamais commité).
KEYCLOAK_ADMIN_REALM=gtm-growth
KEYCLOAK_ADMIN_CLIENT_ID=gtm-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Émetteurs supplémentaires (realms dédiés hors registre), séparés par des virgules.
OIDC_EXTRA_ISSUERS=

# --- Cloud subscriptions (GTM Mollie profile ONLY; never reuse OpenDPE's keys) ---
# Disabled by default; leave checkout OFF during test and deploy preparation.
BILLING_MODE=disabled                  # disabled | test | live
BILLING_CHECKOUT_ENABLED=false
# MOLLIE_GTM_PROFILE_ID=pfl_...
# MOLLIE_GTM_API_KEY=                 # key from dedicated GTM Mollie website profile
MOLLIE_GTM_WEBHOOK_URL=https://gtm.kayroslab.com/api/billing/mollie/webhook
MOLLIE_GTM_RETURN_URL=https://gtm.kayroslab.com/console/?checkout=return
# BILLING_TERMS_VERSION=              # published and legally reviewed CGV revision
BILLING_PRICES_APPROVED=false          # tax/accounting review gate
# BILLING_PRICE_INCLUDES_TAX=          # required in live: true or false
# BILLING_SOLO_AMOUNT_CENTS=3900       # final charge amount after fiscal review
# BILLING_AGENCY_AMOUNT_CENTS=14900
# BILLING_LIVE_APPROVED=false          # explicit owner go/no-go for live
BILLING_GRACE_DAYS=7
BILLING_RECONCILE_ENABLED=false
# BILLING_RECONCILE_TOKEN=             # different from MCP and Keycloak secrets
# BILLING_DATA_PATH=/data/billing.sqlite3
