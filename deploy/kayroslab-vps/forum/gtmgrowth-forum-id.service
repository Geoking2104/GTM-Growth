# Managed by the GTM Growth forum installer.
[Unit]
Description=Forward the GTM forum's TLS connection to Discourse ID

[Service]
ExecStart=/bin/bash /opt/gtm-growth-forum/run-id-proxy.sh
DynamicUser=yes
User=gtm-forum-id-proxy
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
