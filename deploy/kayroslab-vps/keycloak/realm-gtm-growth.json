{
  "realm": "gtm-growth",
  "displayName": "GTM Growth",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "roles": {
    "realm": [
      {
        "name": "console-user",
        "description": "Accès à la console GTM Growth"
      }
    ]
  },
  "clients": [
    {
      "clientId": "gtm-console",
      "name": "Console GTM Growth",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "https://gtm.kayroslab.com",
      "baseUrl": "/console/",
      "redirectUris": [
        "https://gtm.kayroslab.com/console/*"
      ],
      "webOrigins": [
        "https://gtm.kayroslab.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://gtm.kayroslab.com/console/*"
      },
      "protocolMappers": [
        {
          "name": "audience gtm-console",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "gtm-console",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
