# Required for Service Account authentication
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or paste the JSON content directly (less secure)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Default GA4 Property ID (optional if you always specify it in tools)
GA4_PROPERTY_ID=123456789

# Server configuration
PORT=3000
TRANSPORT=http          # http | stdio
HOST=0.0.0.0

# HTTP transport auth (recommended for any public/remote deployment).
# When set, clients must send: Authorization: Bearer <MCP_API_TOKEN>
# Leave unset to run open (local / trusted networks only).
# MCP_API_TOKEN=change-me-to-a-long-random-string

# Optional: Redis cache (highly recommended in production)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:password@your-redis-host:6379

# Cache TTLs in seconds (optional)
# CACHE_TTL_REPORT=600        # 10 minutes
# CACHE_TTL_METADATA=3600     # 1 hour
# CACHE_TTL_PROPERTIES=1800   # 30 minutes

# Optional: restrict allowed properties (comma-separated)
# ALLOWED_PROPERTY_IDS=123456789,987654321

# PageSpeed Insights / Chrome UX Report (optional but recommended)
# Create a key in Google Cloud and enable the APIs.
# PAGESPEED_API_KEY=
# CRUX_API_KEY=
# or a shared key:
# GOOGLE_API_KEY=

# Logging
LOG_LEVEL=info

# Writes are DISABLED by default. Set to true only when you intend to mutate config.
GA4_WRITE_ENABLED=false
GTM_WRITE_ENABLED=false
SEARCH_CONSOLE_WRITE_ENABLED=false
INDEXING_WRITE_ENABLED=false

# --- Operations layer (T-1/T-4/T-9/T-10/T-11) ---
# AI-visibility live checks (BYOK per tenant, same keys as /ai-visibility routes)
# AI_VISIBILITY_OPENAI_KEY_<TENANT_ID_UPPER>=
# AI_VISIBILITY_GEMINI_KEY_<TENANT_ID_UPPER>=
# AI_VISIBILITY_CLAUDE_KEY_<TENANT_ID_UPPER>=
# AI_VISIBILITY_MISTRAL_KEY_<TENANT_ID_UPPER>=
# AI_VISIBILITY_GROK_KEY_<TENANT_ID_UPPER>=
# Optional model overrides for these three providers, scoped to the same tenant:
# AI_VISIBILITY_CLAUDE_MODEL_<TENANT_ID_UPPER>=claude-sonnet-4-6
# AI_VISIBILITY_MISTRAL_MODEL_<TENANT_ID_UPPER>=mistral-medium-latest
# AI_VISIBILITY_GROK_MODEL_<TENANT_ID_UPPER>=grok-4.7
# Keyword rank tracking: SERP supplier (BYOK, JSON API with organic_results) or scraper profile
# RANK_SUPPLIER_URL=
# RANK_SUPPLIER_TOKEN=
# RANK_SCRAPER_URL=
# Article pipeline: Ollama self-hosted model for long-form drafts
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral
# WordPress publishing (per tenant)
# WP_SITE_URL_<TENANT_ID_UPPER>=https://example.com
# WP_USERNAME_<TENANT_ID_UPPER>=
# WP_APP_PASSWORD_<TENANT_ID_UPPER>=
# Automation scheduler (visibility + rank checks). Disabled by default.
# OPS_SCHEDULER_ENABLED=false
# OPS_SCHEDULER_MINUTES=15

# Optional local SEO SQLite path; default is next to TENANTS_PATH.
# LOCAL_SEO_PATH=/data/local-seo.sqlite3

# --- E-commerce connectors (Shopify & PrestaShop) ---
# 32-byte base64 key sealing store credentials and webhook secrets (openssl rand -base64 32).
# Required before any store can be connected; no insecure default.
# ECOMMERCE_DATA_KEY_B64=
# SQLite store path; default is next to TENANTS_PATH (ecommerce/ecommerce.sqlite3).
# ECOMMERCE_STORE_PATH=
# Pinned Shopify GraphQL Admin API version (checked quarterly).
# SHOPIFY_API_VERSION=2026-01
# Allow http PrestaShop URLs for local testing only (never in production).
# PRESTASHOP_ALLOW_HTTP=false

# Optional tenant-scoped GBP integration. Credentials stay in read-only secret files.
# GBP_CREDENTIALS_DIR=/secrets/gbp
# LOCAL_SEO_WORKERS_FILE=/secrets/local-seo-workers.json
LOCAL_SEO_PUBLISH_ENABLED=false
