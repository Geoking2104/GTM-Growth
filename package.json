{
  "name": "google-growth",
  "version": "0.19.0",
  "description": "Open-source MCP server connecting GA4, GTM/sGTM, Search Console, Indexing API, PageSpeed, CrUX and GEO/AEO audits to Grok, Claude, and Codex",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-growth": "./dist/index.js",
    "google-growth-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "cli": "tsx src/cli.ts",
    "cli:audit-web": "tsx src/cli.ts audit-web",
    "cli:audit-sgtm": "tsx src/cli.ts audit-sgtm",
    "cli:verify-secrets": "tsx src/cli.ts verify-secrets",
    "cli:suggest-mp": "tsx src/cli.ts suggest-mp",
    "cli:compare-dual": "tsx src/cli.ts compare-dual",
    "cli:cutover": "tsx src/cli.ts cutover-checklist",
    "cli:health": "tsx src/cli.ts health",
    "cli:observability": "tsx src/cli.ts observability",
    "cli:list-sgtm": "tsx src/cli.ts list-sgtm",
    "cli:pagespeed": "tsx src/cli.ts pagespeed",
    "cli:crux": "tsx src/cli.ts crux",
    "cli:geo-audit": "tsx src/cli.ts geo-audit",
    "cli:geo-sitemap": "tsx src/cli.ts geo-sitemap",
    "cli:geo-llms": "tsx src/cli.ts geo-llms",
    "cli:geo-schema": "tsx src/cli.ts geo-schema",
    "cli:geo-robots": "tsx src/cli.ts geo-robots",
    "demo:geo": "node scripts/geo-demo.mjs",
    "validate:ci": "bash scripts/ci-validate.sh",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "prepublishOnly": "npm run build && npm test",
    "figures": "node scripts/render-figures.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:dry-run": "wrangler deploy --dry-run --outdir=.worker-build",
    "site:api": "node scripts/set-api.mjs"
  },
  "keywords": [
    "mcp",
    "google-analytics",
    "ga4",
    "gtm",
    "sgtm",
    "search-console",
    "pagespeed",
    "crux",
    "geo",
    "aeo",
    "llms-txt",
    "generative-engine-optimization",
    "ai-search",
    "grok",
    "claude",
    "codex",
    "model-context-protocol",
    "analytics"
  ],
  "author": "Geoffroy de La Tournelle <geoffroydelatournelle@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Geoking2104/Google-Growth.git"
  },
  "bugs": {
    "url": "https://github.com/Geoking2104/Google-Growth/issues"
  },
  "homepage": "https://github.com/Geoking2104/Google-Growth#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.2",
    "pdfkit": "^0.20.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.157.0"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
